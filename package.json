{
  "name": "kilo-factory",
  "version": "0.1.0",
  "description": "Deterministic unattended-work controller for the Kilo CLI",
  "type": "module",
  "bin": {
    "factory": "./dist/cli.js"
  },
  "main": "./dist/plugin.js",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/OPERATIONS.md"
  ],
  "engines": {
    "bun": ">=1.2.0",
    "opencode": ">=7.5.6 <8"
  },
  "scripts": {
    "prepublishOnly": "bun run build",
    "build": "bun scripts/build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun run build && bun test",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@kilocode/plugin": "7.5.6",
    "@types/bun": "1.4.0",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.4.0"
}
